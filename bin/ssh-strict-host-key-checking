#!/usr/bin/env bash
# ex: set filetype=sh fenc=utf-8 expandtab ts=4 sw=4 :

set -euo pipefail
umask 027
export PATH=/usr/local/sbin:/sbin:/bin:/usr/sbin:/usr/bin

ssh \
    -oControlMaster=no \
    -oControlPath=none \
    -oControlPersist=no \
    -oStrictHostKeyChecking=ask \
    -oUpdateHostKeys=ask \
    -oCheckHostIP=yes \
    -oVisualHostKey=yes \
    "$@"

exit 0
    -o UserKnownHostsFile=/dev/null \
