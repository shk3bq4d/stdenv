#!/usr/bin/env bash

set -Eeuo pipefail
shopt -s inherit_errexit
umask 007

exec > >(tee -a ~/.tmp/log/"$(basename "$0" .sh).log")
exec 2>&1

case $(hostname -f) in \
    "${WORK_PC1F:-workpc1funset}")
        ROOT=/mnt/local/00-1to
        ROOT=$HOME
        ;;
    *)
        ROOT=$HOME
        ;;
esac
# del old empty dir
for i in ${ROOT}/.tmpp/*; do
        if [[ -d $i ]]; then
                if find $i -maxdepth 0 -empty | read; then
                        rmdir $i
                fi
        fi
done

newdir="${ROOT}/.tmpp/$(date +'%Y%m%d')"
[[ ! -d $newdir ]] && mkdir -p $newdir
chmod 0700 $newdir
target=~/tmp
if [[ "$(readlink -f "$newdir")" == "$(readlink -f "$target")" ]] && [[ -L $target ]]; then
    exit 0
fi
[[ -L $target ]] && rm $target
[[ -d $target ]] && rmdir $target
[[ -e $target ]] && echo "FATAL: can't get rid of existing $target" && exit 1
ln -s $newdir $target
echo EOF
exit 0
