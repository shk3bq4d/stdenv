#!/usr/bin/env bash
# /* ex: set filetype=sh fenc=utf-8 expandtab ts=4 sw=4 : */

set -euo pipefail

kubectl_version=1.31.11
kubectl_version=1.33.5
kubectl_version=1.35.3
kubectl_version=1.35.4
#https://storage.googleapis.com/kubernetes-release/release/stable.txt

if [[ -n "${SUDO_USER:-}" ]]; then
    H=$(eval echo ~"${SUDO_USER:-}")
elif [[ -n "${HOME:-}" ]]; then
    H="${HOME:-}"
else
    cd
    H="${PWD}"
fi

BIN="$H/bin/kubectl-$kubectl_version"
# https://kubernetes.io/docs/tasks/tools/install-kubectl/
# curl -LO "https://dl.k8s.io/release/$(curl -L -s https://dl.k8s.io/release/stable.txt)/bin/linux/amd64/kubectl"
if [[ ! -f "$BIN" ]]; then
    if [[ ! -t 1 ]]; then
        [[ $# -gt 1 ]] && [[ "$1" == "completion" ]] && exit 1
        >&2 echo "FATAL: no tty and no such file $BIN when calling with args $@"
        exit 1
    fi
    >&2 echo -n "$BIN doesn't exist. Would you like to download it? (yN): "
    read _read
    >&2 echo # read
    case "${_read,,}" in \
    y|Y|yes)
        true
        ;;
    *)
        BIN="$(find "$H/bin" -maxdepth 1 -type f -name "kubectl-*" | { grep -E '/kubectl-[0-9]+\.[0-9]+\.[0-9]+$' || true; } | sort -V | tail -n 1)"
        if [[ -f "$BIN" ]]; then
            >&2 echo "Using $BIN instead"
        else
            exit 1
        fi
        ;;
    esac
    if [[ ! -f "$BIN" ]]; then
        test -d ~/.tmp || mkdir ~/.tmp
        cd ~/.tmp
        curl -sLO "https://dl.k8s.io/release/v${kubectl_version}/bin/linux/amd64/kubectl"
        mv -f ~/.tmp/kubectl $BIN
        chmod u+x $BIN
        if [[ -n "${SUDO_USER:-}" ]]; then
            chown "${SUDO_USER:-}": $BIN
        fi
    fi
fi

if [[ -n "${STDENV_KUBE_CONTEXT:-}" && "$@" != *"--context"* ]]; then
    $BIN --context "${STDENV_KUBE_CONTEXT:-}" "$@"
else
    $BIN "$@"
fi
exit $?
