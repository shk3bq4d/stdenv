#!/usr/bin/env bash
# ex: set filetype=sh fenc=utf-8 expandtab ts=4 sw=4 :

set -euo pipefail
# date '+%a %b %d %H:%M' -d @1747872031
umask 027
export PATH=/usr/local/sbin:/sbin:/usr/local/bin:/bin:/usr/sbin:/usr/bin:~/bin
export PS4='+ ${BASH_SOURCE:-}:${LINENO:-}:${FUNCNAME[0]:-}: ';

source ~/bin/dot.gitfunctions

f=~/bin/mrurxvt.blacklist
s=$(
xprop -id "$(xdotool getactivewindow)" |
    sed -r -n -e '
/WM_COMMAND/s/.*load.*tmp\/mrurxvt\/+(.*).jpg.*/\1/ p
    '
)
if grep -F "$s" "$f"; then
    echo "duplicate $s!"
else
    hf=$(hostname -f)
    if ! grep -x $hf $f; then
        echo "$hf" >> $f
    fi
    sed -i -e "/$hf/a $s" "$f"
    cd "$HOME/git/$(id -un)/stdenv"
    git commit -m "mrurxvt.blacklist" $f
    git_is_current_repo_clean && git pull --rebase=true && git push
    echo "ok $s!"
fi
exit 0
