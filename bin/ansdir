#!/usr/bin/env bash
# ex: set filetype=sh fenc=utf-8 expandtab ts=4 sw=4 :

set -euo pipefail
umask 027
export PATH=/usr/local/sbin:/sbin:/usr/local/bin:/bin:/usr/sbin:/usr/bin:~/bin

all_dirs() {
    cat << 'EOF'
.
ans
..
../ans
../..
../../ans
../../..
../../../ans
../../../..
../../../../ans
../../../../..
../../../../../ans
../../../../../..
../../../../../../ans
EOF
}

for d in $(all_dirs); do
    if [[ -f $d/inventory.yml ]] || [[ -f $d/inventory.ini ]]; then
        echo $d
        exit 0
    fi
done

exit 1
